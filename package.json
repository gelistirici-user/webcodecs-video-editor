{
  "name": "kurgu-studio",
  "productName": "Kurgu Studio",
  "version": "2.0.0",
  "description": "Premiere Pro ve DaVinci Resolve'dan esinlenen hafif, masaüstü video editörü",
  "main": "main.js",
  "author": "gelistirici-user",
  "license": "MIT",
  "scripts": {
    "prestart": "node scripts/vendor.js",
    "start": "electron .",
    "preserve": "node scripts/vendor.js",
    "serve": "node scripts/serve.js",
    "vendor": "node scripts/vendor.js",
    "dist": "npm run vendor && electron-builder --win portable nsis"
  },
  "build": {
    "appId": "com.kurgustudio.app",
    "productName": "Kurgu Studio",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "KurguStudio-Portable-${version}.exe"
    },
    "fileAssociations": [
      {
        "ext": "kurgu",
        "name": "Kurgu Studio Projesi"
      }
    ],
    "compression": "maximum",
    "asar": true
  },
  "devDependencies": {
    "@huggingface/transformers": "^3.8.1",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "mediabunny": "^1.66.4"
  }
}
